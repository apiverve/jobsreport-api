        "jobsreport",
        "jobs report",
        "unemployment rate",
        "employment data",
        "bls jobs",
        "nonfarm payrolls"
    ],
    "homepage": "https://apiverve.com/marketplace/jobsreport?utm_source=php&utm_medium=homepage",
    "support": {
        "email": "hello@apiverve.com",
